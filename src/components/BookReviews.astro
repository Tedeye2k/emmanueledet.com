---
// Editorial layout for the Books page: one book per row, cover on the left.
// Every optional detail (cover image, writer, year, genre, rating, date,
// one-line quote, short review, reread, full review link) only shows when
// it is filled in on Sanity.
import { imageUrl, imageAlt, link, formatDate, type ShelfItem } from '../lib/sanity';
interface Props { items: ShelfItem[]; }
const { items } = Astro.props;
const rated = (n?: number) => (typeof n === 'number' && n > 0 ? Math.min(5, Math.round(n * 2) / 2) : 0);
const againText: Record<string, string> = { yes: 'Yes', maybe: 'Maybe', no: 'No' };
---
{items.length === 0 ? (
  <p class="empty mono">Nothing here yet. Check back soon.</p>
) : (
  <ol class="bookrev-list">
    {items.map((item) => {
      const src = imageUrl(item.cover, 520, 780);
      const stars = rated(item.rating);
      const meta = ['Book', item.year, item.genre].filter(Boolean).join(' · ');
      const date = formatDate(item.date);
      const again = item.again ? againText[item.again] : '';
      return (
        <li class="bookrev">
          <div class="bookrev-cover">
            {src ? (
              <img src={src} alt={imageAlt(item.cover, `Cover of ${item.title}`)} width="520" height="780" loading="lazy" />
            ) : (
              <div class="bookrev-cover-blank" aria-hidden="true">
                {item.by && <span class="mono">{item.by}</span>}
                <span class="bookrev-cover-title">{item.title}</span>
              </div>
            )}
          </div>

          <div class="bookrev-body">
            <span class="bookrev-meta mono">{meta}</span>
            <div class="bookrev-heading">
              <h2 class="bookrev-title">{item.title}</h2>
              {item.by && <span class="bookrev-by">by {item.by}</span>}
            </div>

            {(stars > 0 || date) && (
              <div class="bookrev-rating">
                {stars > 0 && <span class="bookrev-score">{stars % 1 ? stars : `${stars}.0`}</span>}
                {stars > 0 && (
                  <span class="stub-stars bookrev-stars" role="img" aria-label={`Rated ${stars} out of 5`}>
                    <span aria-hidden="true" class="stub-stars-off">★★★★★</span>
                    <span aria-hidden="true" class="stub-stars-on" style={`width: ${(stars / 5) * 100}%`}>★★★★★</span>
                  </span>
                )}
                {date && <span class="bookrev-date">Finished {date}</span>}
              </div>
            )}

            {item.note && <blockquote class="bookrev-quote">“{item.note}”</blockquote>}
            {item.summary && <p class="bookrev-summary">{item.summary}</p>}

            {(again || item.slug) && (
              <div class="bookrev-foot">
                {again && <span class={`bookrev-chip is-${item.again}`}>Reread: {again}</span>}
                {item.slug && (
                  <a class="text-link bookrev-link" href={link(`/books/${item.slug}/`)}>
                    Read the full review
                    <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2 6h8M6.5 2.5L10 6l-3.5 3.5"/></svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ol>
)}
