---
// One full book or movie review. Only pieces with text in "Full review" get a page.
import { bodyHtml, imageUrl, imageAlt, link, formatDate, type ShelfItem } from '../lib/sanity';
interface Props { item: ShelfItem; kind: 'book' | 'movie'; }
const { item, kind } = Astro.props;
const isMovie = kind === 'movie';
const cover = imageUrl(item.cover, 600, 900);
const stars = typeof item.rating === 'number' && item.rating > 0 ? Math.min(5, Math.round(item.rating * 2) / 2) : 0;
const again = item.again ? { yes: 'Yes', maybe: 'Maybe', no: 'No' }[item.again] : '';
const meta = [
  isMovie ? 'Movie' : 'Book',
  isMovie && item.by ? `Dir. ${item.by}` : item.by,
  item.year,
  item.genre,
  item.date && `${isMovie ? 'Watched' : 'Finished'} ${formatDate(item.date)}`,
].filter(Boolean);
---
<article class="article">
  <a class="back mono" href={link(isMovie ? '/movies/' : '/books/')}>
    <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 6H2M5.5 2.5L2 6l3.5 3.5"/></svg>
    {isMovie ? 'All movies' : 'All books'}
  </a>
  <div class="article-meta mono">{meta.map((m) => <span>{m}</span>)}</div>
  <h1 class="article-title">{item.title}</h1>
  {item.note && <p class="article-lead">{item.note}</p>}
  {(stars > 0 || again) && (
    <div class="review-facts">
      {stars > 0 && (
        <span class="stub-stars" role="img" aria-label={`Rated ${stars} out of 5`}>
          <span aria-hidden="true" class="stub-stars-off">★★★★★</span>
          <span aria-hidden="true" class="stub-stars-on" style={`width: ${(stars / 5) * 100}%`}>★★★★★</span>
        </span>
      )}
      {again && <span class={`stub-stamp mono is-${item.again}`}>{isMovie ? 'Rewatch' : 'Reread'}: {again}</span>}
    </div>
  )}
  {cover && (
    <figure class="review-poster"><img src={cover} alt={imageAlt(item.cover, `${isMovie ? 'Poster' : 'Cover'} of ${item.title}`)} width="600" height="900" /></figure>
  )}
  <div class="prose" set:html={bodyHtml(item.review)} />
  <div class="article-end">
    <p>Thanks for reading. Got a project or a thought to share?</p>
    <a class="btn-solid" href={link('/contact/')}>Get in touch
      <svg aria-hidden="true" width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2.5 9.5l7-7M4 2.5h5.5V8"/></svg>
    </a>
  </div>
</article>
