---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { getCaseStudies } from '../../lib/sanity';
export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Base title={entry.title} description={entry.excerpt} section="case-studies">
  <Article entry={entry} backLabel="All case studies" backHref="/case-studies/" meta={[entry.client, entry.role, entry.year]} />
</Base>
