---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EntryList from '../../components/EntryList.astro';
import { getSettings, getCaseStudies } from '../../lib/sanity';
const settings = await getSettings();
const studies = await getCaseStudies();
---
<Base title="Case Study" description={settings.caseStudyIntro} section="case-studies">
  <PageHead label="Case Study" title={settings.caseStudyTitle} intro={settings.caseStudyIntro} />
  <EntryList entries={studies} base="/case-studies/" kind="caseStudy" />
</Base>
