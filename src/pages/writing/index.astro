---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EntryList from '../../components/EntryList.astro';
import { getSettings, getPosts } from '../../lib/sanity';
const settings = await getSettings();
const posts = await getPosts();
---
<Base title="Writing" description={settings.writingIntro} section="writing">
  <PageHead label="Writing" title={settings.writingTitle} intro={settings.writingIntro} />
  <EntryList entries={posts} base="/writing/" kind="post" />
</Base>
