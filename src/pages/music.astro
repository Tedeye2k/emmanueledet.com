---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getSettings, getCredits } from '../lib/sanity';
const settings = await getSettings();
const credits = await getCredits();
const arrow = 'M2.5 9.5l7-7M4 2.5h5.5V8';
---
<Base title="Music" description={settings.musicIntro} section="music">
  <PageHead label="Music" title={settings.musicTitle} intro={settings.musicIntro} />
  <div class="page-cta">
    <a class="btn-solid" href={settings.musicUrl} target="_blank" rel="noopener">Listen on Resparkit
      <svg aria-hidden="true" width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d={arrow}/></svg>
    </a>
  </div>

  <h2 class="section-label mono">Production &amp; songwriting credits</h2>
  {credits.length === 0 ? (
    <p class="empty mono">Credits coming soon.</p>
  ) : (
    <ul class="rows">
      {credits.map((credit) => {
        const Tag = credit.url ? 'a' : 'div';
        const attrs = credit.url ? { href: credit.url, target: '_blank', rel: 'noopener' } : {};
        return (
          <li>
            <Tag class="row" {...attrs}>
              <span class="row-label mono">{credit.year || ''}</span>
              <span class="row-main">
                <span class="row-title">{credit.title}</span>
                {credit.artist && <span class="row-sub">{credit.artist}</span>}
              </span>
              <span class="row-tags mono">{(credit.roles || []).join(' · ')}</span>
              {credit.url ? (
                <svg class="entry-arrow" aria-hidden="true" width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d={arrow}/></svg>
              ) : <span />}
            </Tag>
          </li>
        );
      })}
    </ul>
  )}
</Base>
