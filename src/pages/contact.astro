---
import Base from '../layouts/Base.astro';
import { getSettings, getSocials, richLine } from '../lib/sanity';
const settings = await getSettings();
const socials = await getSocials();
const formKey = settings.contactFormKey;
const mailto = `mailto:${settings.email}`;
---
<Base title="Contact" description={settings.contactIntro} section="contact" center>
  <div class="contact">
    <div class="page-head page-head-center">
      <span class="eyebrow mono">Contact</span>
      <h1 class="page-title" set:html={richLine(settings.contactTitle)} />
      <p class="page-intro">{settings.contactIntro}</p>
    </div>

    <div class="contact-actions">
      <!-- Opens the form when a form key is set; otherwise opens the visitor's email app -->
      <a class="btn-line btn-big btn-email mono" id="email-button" href={mailto}
        aria-controls={formKey ? 'contact-form' : undefined} aria-expanded={formKey ? 'false' : undefined}>
        Send an email
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 9.5l7-7M4 2.5h5.5V8"/></svg>
      </a>
      {socials.map((social) => (
        <a class="btn-line btn-big mono" href={social.url} target="_blank" rel="noopener me">{social.label}</a>
      ))}
    </div>

    {formKey && (
      <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST" hidden>
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value={`New message from ${settings.name}'s website`} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <label class="mono" for="cf-name">Your name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label class="mono" for="cf-email">Your email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label class="mono" for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" required></textarea>
        </div>

        <div class="form-foot">
          <button class="btn-solid" type="submit">Send message
            <svg aria-hidden="true" width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2.5 9.5l7-7M4 2.5h5.5V8"/></svg>
          </button>
          <span class="form-alt">Or write to <a href={mailto}>{settings.email}</a></span>
        </div>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    )}
  </div>

  {formKey && (
    <script is:inline>
      (function () {
        var button = document.getElementById('email-button');
        var form = document.getElementById('contact-form');
        var status = document.getElementById('form-status');
        if (!button || !form) return;

        // The button reveals the form instead of opening an email app
        button.addEventListener('click', function (event) {
          event.preventDefault();
          var open = form.hidden;
          form.hidden = !open;
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (open) {
            form.querySelector('input[name="name"]').focus({ preventScroll: true });
            form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var send = form.querySelector('button[type="submit"]');
          var data = {};
          new FormData(form).forEach(function (value, key) { data[key] = value; });
          if (data.botcheck) return;
          delete data.botcheck;

          send.disabled = true;
          status.textContent = 'Sending…';

          fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data)
          })
            .then(function (response) { return response.json(); })
            .then(function (result) {
              if (!result.success) throw new Error(result.message || 'Not sent');
              var done = document.createElement('p');
              done.className = 'form-done';
              done.setAttribute('role', 'status');
              done.textContent = 'Thank you. Your message is on its way, and I’ll reply soon.';
              form.replaceWith(done);
              button.setAttribute('aria-expanded', 'false');
            })
            .catch(function () {
              send.disabled = false;
              status.textContent = 'That didn’t send. Please try again, or use the email address above.';
            });
        });
      })();
    </script>
  )}
</Base>
