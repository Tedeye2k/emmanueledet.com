---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EntryList from '../../components/EntryList.astro';
import { getSettings, getThoughts } from '../../lib/sanity';
const settings = await getSettings();
const thoughts = await getThoughts();
---
<Base title="Thoughts" description={settings.thoughtsIntro} section="thoughts">
  <PageHead label="Thoughts" title={settings.thoughtsTitle} intro={settings.thoughtsIntro} />
  <EntryList entries={thoughts} base="/thoughts/" kind="thought" />
</Base>
