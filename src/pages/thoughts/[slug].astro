---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { getThoughts, formatDate } from '../../lib/sanity';
export async function getStaticPaths() {
  const thoughts = await getThoughts();
  return thoughts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Base title={entry.title} section="thoughts">
  <Article entry={entry} backLabel="All thoughts" backHref="/thoughts/" meta={[formatDate(entry.date)]} />
</Base>
