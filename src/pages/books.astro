---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Shelf from '../components/Shelf.astro';
import { getSettings, getBooks } from '../lib/sanity';
const settings = await getSettings();
const books = await getBooks();
---
<Base title="Books" description={settings.booksIntro} section="books">
  <PageHead label="Books" title={settings.booksTitle} intro={settings.booksIntro} />
  <Shelf items={books} />
</Base>
